{
  "manifest_version": 3,
  "name": "ChatGPT: пакетная генерация изображений CONTROL",
  "version": "2.3.2",
  "description": "Очередь промтов для ChatGPT с контролем готовности, повторами и ZIP-архивом по промтам",
  "icons": {
    "16": "icon128.png",
    "48": "icon128.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Показать/скрыть панель",
    "default_icon": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": [
        "sidebar.css"
      ],
      "js": [
        "jszip.min.js",
        "prompts.js",
        "automation.js",
        "sidebar.js"
      ]
    }
  ]
}
