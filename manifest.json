{
  "manifest_version": 3,
  "name": "Gemini Lookbook Queue",
  "version": "0.1.0",
  "description": "A local prompt queue for manual Gemini image-generation workflows.",
  "action": {
    "default_title": "Gemini Lookbook Queue",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://gemini.google.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
